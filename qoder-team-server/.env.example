# Database
# 本地开发
DATABASE_URL="postgresql://qoder:qoder@localhost:5432/qoder_team?schema=public"

# 线上生产环境（替换为你的云数据库地址）
# DATABASE_URL="postgresql://username:password@your-db-host:5432/qoder_team?schema=public"

# JWT Secret（生产环境必须更换为强随机字符串）
JWT_SECRET="qoder-team-dev-secret-change-in-production"

# Server port
PORT=3000

# Frontend URL（CORS 允许的来源）
# 开发环境
FRONTEND_URL=http://localhost:5173

# 线上生产环境（替换为你的前端域名）
# FRONTEND_URL=https://qoder-team-demo.vercel.app

# Redis URL（可选，用于缓存和 Socket.IO 集群模式）
# 开发环境
REDIS_URL=redis://localhost:6379

# 线上生产环境
# REDIS_URL=redis://your-redis-host:6379
