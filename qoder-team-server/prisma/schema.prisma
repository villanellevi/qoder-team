// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  avatar    String?
  role      String   @default("member") // admin, member, guest
  password  String
  createdAt DateTime @default(now())

  teams     TeamMember[]
  messages  ChatMessage[]
  docs      Document[]
  agents    Agent[]

  sentInvitations     TeamInvitation[] @relation("SentInvitations")
}

model Team {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  members  TeamMember[]
  channels Channel[]
  docs     Document[]
  agents   Agent[]
  projects Project[]

  invitations TeamInvitation[]
}

model TeamMember {
  id     String @id @default(uuid())
  userId String
  teamId String
  role   String @default("member") // owner, admin, member

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model TeamInvitation {
  id        String   @id @default(uuid())
  teamId    String
  inviterId String
  email     String
  code      String   @unique
  status    String   @default("pending") // pending, accepted, expired
  createdAt DateTime @default(now())
  expiresAt DateTime

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter User @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
}

model Channel {
  id        String   @id @default(uuid())
  teamId    String
  name      String
  type      String   // group, direct, myagent
  members   String[] // userId[]
  createdAt DateTime @default(now())

  messages ChatMessage[]
  team     Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id         String @id @default(uuid())
  channelId  String
  senderId   String
  senderType String // human, agent
  content    String
  artifact   Json?
  kbRefs     String[]
  createdAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model Document {
  id        String @id @default(uuid())
  teamId    String
  authorId  String
  title     String
  content   String
  source    String // human, agent, collab
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([teamId, source])
}

model Agent {
  id          String @id @default(uuid())
  userId      String
  teamId      String?
  name        String
  icon        String  @default("🤖")
  systemPrompt String  @default("You are a helpful assistant.")
  createdAt   DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  skills  AgentSkill[]
  memory  AgentMemory[]
  faq     AgentFAQ[]
  workflows AgentWorkflow[]
}

model AgentSkill {
  id      String @id @default(uuid())
  agentId String
  name    String
  desc    String

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model AgentMemory {
  id        String @id @default(uuid())
  agentId   String
  key       String
  value     String
  updatedAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model AgentFAQ {
  id       String @id @default(uuid())
  agentId  String
  question String
  answer   String
  likes    Int    @default(0)
  dislikes Int    @default(0)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model AgentWorkflow {
  id      String   @id @default(uuid())
  agentId String
  name    String
  steps   String[]

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Project {
  id        String   @id @default(uuid())
  teamId    String
  name      String
  slug      String
  status    String   @default("active")
  progress  Int      @default(0)
  desc      String
  deadline  String
  createdAt DateTime @default(now())

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  todos      Todo[]
}

model Milestone {
  id        String   @id @default(uuid())
  projectId String
  name      String
  status    String   @default("waiting")
  date      String
  owner     String
  createdAt DateTime @default(now())

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requiredArtifacts  MilestoneArtifact[]
  gate               MilestoneGate?
}

model MilestoneArtifact {
  id           String  @id @default(uuid())
  milestoneId  String
  name         String
  type         String
  status       String  @default("missing")
  author       String?
  completedAt  String?
  docId        String?

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

model MilestoneGate {
  id          String  @id @default(uuid())
  milestoneId String  @unique
  name        String
  passed      Boolean @default(false)

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

model Todo {
  id        String   @id @default(uuid())
  projectId String?
  teamId    String?
  title     String
  assignee  String
  priority  String   @default("medium")
  status    String   @default("todo")
  due       String
  type      String   @default("human")
  background String?
  materials  String[]
  actions    String[]
  agent      String?
  agentIcon  String?
  progress   String?
  createdAt  DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model PendingItem {
  id            String   @id @default(uuid())
  teamId        String?
  title         String
  desc          String
  assigner      String
  assignerType  String   @default("human")
  assignerIcon  String?
  status        String   @default("pending")
  context       String?
  relatedMember String?
  createdAt     DateTime @default(now())
}

model DailyReport {
  id         String   @id @default(uuid())
  teamId     String?
  memberId   String
  date       String
  done       String[]
  todo       String[]
  blockers   String[]
  humanFocus String[]
  agentFocus String[]
  createdAt  DateTime @default(now())
}

model ActivityItem {
  id        String   @id @default(uuid())
  teamId    String?
  icon      String
  text      String
  time      String
  type      String   @default("human")
  createdAt DateTime @default(now())
}

model AgentQARecord {
  id        String   @id @default(uuid())
  teamId    String?
  name      String
  icon      String
  owner     String
  tasks     Int      @default(0)
  completed Int      @default(0)
  errors    Int      @default(0)
  avgTime   String   @default("0")
  accuracy  String   @default("0%")
  createdAt DateTime @default(now())
}

model CollabLogItem {
  id        String   @id @default(uuid())
  teamId    String?
  fromId    String
  fromName  String
  toId      String
  toName    String
  type      String
  status    String
  time      String
  createdAt DateTime @default(now())
}
